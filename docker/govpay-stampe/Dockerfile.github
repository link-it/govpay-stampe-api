FROM eclipse-temurin:25-jre-alpine

ARG govpay_stampe_fullversion
# sha256 del jar della release: la pipeline lo calcola dall'artifact della
# build, build_image.sh lo legge dalle API delle release di GitHub.
ARG govpay_stampe_sha256
ARG govpay_stampe_home=/opt/govpay-stampe
ARG govpay_stampe_log=/var/log/govpay-stampe

LABEL maintainer="Link.it s.r.l."
LABEL description="GovPay Stampe REST API"
LABEL govpay.stampe.version="${govpay_stampe_fullversion}"
USER root

ENV GOVPAY_STAMPE_FULLVERSION=${govpay_stampe_fullversion} \
GOVPAY_STAMPE_LOGDIR=${govpay_stampe_log} \
GOVPAY_STAMPE_HOME=${govpay_stampe_home} \
TZ=Europe/Rome


RUN set -eux; \
apk update; \
apk upgrade; \
# Solo cio' che serve a runtime: bash per l'entrypoint, tzdata per il fuso
# orario. tar, unzip, netcat e curl non sono usati dall'entrypoint, e ogni
# pacchetto in piu' e' superficie esposta e segnalazioni della scansione.
apk add --no-cache bash tzdata; \
rm -rf /var/cache/apk/*; \
echo "${TZ}" > /etc/timezone; \
addgroup -S govpay ; \
adduser -S -G govpay govpay; \
mkdir -p ${GOVPAY_STAMPE_HOME} ${GOVPAY_STAMPE_LOGDIR}; \
chown -R govpay:govpay ${GOVPAY_STAMPE_HOME} ${GOVPAY_STAMPE_LOGDIR}

WORKDIR ${GOVPAY_STAMPE_HOME}

# Download del jar dalla release GitHub, con verifica del certificato e del
# checksum: senza checksum l'immagine conterrebbe qualunque file venisse
# servito a quell'indirizzo. curl serve solo qui: installato e rimosso nello
# stesso passo, non resta nell'immagine.
RUN set -eux; \
apk add --no-cache --virtual .download curl; \
test -n "${govpay_stampe_sha256}" || { echo "Manca il build-arg govpay_stampe_sha256 (sha256 del jar della release)"; exit 1; }; \
curl -fL -sS -o /opt/govpay-stampe/govpay-stampe-api.jar "https://github.com/link-it/govpay-stampe-api/releases/download/${GOVPAY_STAMPE_FULLVERSION}/govpay-stampe-api-${GOVPAY_STAMPE_FULLVERSION}.jar"; \
echo "${govpay_stampe_sha256}  /opt/govpay-stampe/govpay-stampe-api.jar" | sha256sum -c -; \
apk del .download


# Copy entrypoint and initialization scripts
COPY commons/entrypoint.sh /usr/local/bin/
RUN chown -R govpay:0 /usr/local/bin/entrypoint.sh ${GOVPAY_STAMPE_HOME} ${GOVPAY_STAMPE_LOGDIR} \
&& chmod -Rf g+rwX ${GOVPAY_STAMPE_HOME} ${GOVPAY_STAMPE_LOGDIR} \
&& chmod ug=rx /usr/local/bin/entrypoint.sh



USER govpay

ENV STAMPE_TIME_ZONE=Europe/Rome \
    LOGGING_FILE_NAME=${GOVPAY_STAMPE_LOGDIR}/govpay-stampe-api.log


ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD []
