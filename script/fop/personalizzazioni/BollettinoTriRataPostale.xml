<?xml version="1.0" encoding="UTF-8"?>
<!--
	Parti di BollettinoTriRataPostale scritte a mano, applicate da jrxml2fo.py (vedi personalizzazioni/RataUnica.xml per il
	formato). Bollettino postale di una rata: contesto dei percorsi relativi, l'elemento rata. Gli elementi
	corrispondono a quelli del bollettino in RataUnicaPostale.
-->
<personalizzazioni xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fo="http://www.w3.org/1999/XSL/Format">

	<!-- "sul C/C n." + numero di conto in RobotoMono grassetto: riga con due font, come ccc9f519 in RataUnicaPostale -->
	<elemento uuid="eae39e6f-c7f4-47a4-9788-417be3aba498" attributi="padding-top=1.4pt">sul C/C n. <fo:inline font-weight="bold" font-family="RobotoMono"><xsl:value-of select="numero_cc_postale"/></fo:inline></elemento>

	<!-- "Euro " (12 pt) + importo in RobotoMono grassetto: riga con due font, padding ridotto di 0,48 pt -->
	<elemento uuid="0bbee3ce-272e-4e97-8d6e-48a7f000abd4" attributi="padding-top=1.774pt">Euro <fo:inline font-weight="bold" font-family="RobotoMono"><xsl:call-template name="importo"><xsl:with-param name="valore" select="importo"/></xsl:call-template></fo:inline></elemento>

	<!-- "RATA UNICA " / "Rata N" + (" entro il " + data | " " + tipo + " " + giorni): spazi come in Jasper -->
	<elemento uuid="3a989a45-13be-4e56-99b7-b3a9279e6d91" attributi="white-space-collapse=false"><xsl:choose><xsl:when test="normalize-space(numero_rata)">Rata <xsl:value-of select="numero_rata"/></xsl:when><xsl:otherwise>RATA UNICA </xsl:otherwise></xsl:choose><xsl:choose><xsl:when test="normalize-space(giorni)"><xsl:value-of select="concat(' ', tipo, ' ')"/><xsl:call-template name="giorni"><xsl:with-param name="giorni" select="giorni"/></xsl:call-template></xsl:when><xsl:when test="normalize-space(data)"> entro il <xsl:value-of select="data"/></xsl:when></xsl:choose></elemento>

</personalizzazioni>
