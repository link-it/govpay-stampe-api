<?xml version="1.0" encoding="UTF-8"?>
<!--
	Parti di DoppiaRata scritte a mano, applicate da jrxml2fo.py (vedi personalizzazioni/RataUnica.xml
	per il formato). Gli elementi corrispondono a quelli di RataUnica, con uuid diversi e la rata unica
	nell'elemento unica.
	Contesto dei percorsi relativi: l'elemento pagine/doppia.
-->
<personalizzazioni xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fo="http://www.w3.org/1999/XSL/Format">

	<!-- "Rata unica " + (" entro il " + data | " " + tipo + " " + giorni): due spazi dopo "unica", come in Jasper -->
	<elemento uuid="049ff347-a1a6-4445-8fd3-2ec5e8ec1775" attributi="white-space-collapse=false">Rata unica <xsl:choose><xsl:when test="normalize-space(unica/giorni)"><xsl:value-of select="concat(' ', unica/tipo, ' ')"/><xsl:call-template name="giorni"><xsl:with-param name="giorni" select="unica/giorni"/></xsl:call-template></xsl:when><xsl:when test="normalize-space(unica/data)"> entro il <xsl:value-of select="unica/data"/></xsl:when></xsl:choose></elemento>

	<!-- "Importo" + importo formattato + " Euro " (come RataUnica b6232d33) -->
	<elemento uuid="1d0a60e9-4d94-4147-ac70-40b84f3869f4" attributi="padding-top=2.023pt"><fo:block font-size="8pt" line-height="10.13pt">Importo</fo:block><fo:block space-before="5.057pt"><xsl:call-template name="importo"><xsl:with-param name="valore" select="unica/importo"/></xsl:call-template> Euro</fo:block></elemento>

	<!-- "oppure sul sito <del_tuo_ente>, " solo se valorizzato (come RataUnica d647fb00) -->
	<elemento uuid="23c32ae4-9200-40c6-9fd6-9302f8314357" attributi="righe=2"><xsl:if test="normalize-space(/AvvisoPagamentoInput/del_tuo_ente)"><xsl:value-of select="concat('oppure sul sito ', /AvvisoPagamentoInput/del_tuo_ente, ', ')"/></xsl:if>dal tuo Home Banking, con la tua app di pagamento o con gli altri canali abilitati.</elemento>

	<!-- scadenza ("entro il" + data) oppure soglia (tipo + giorni) (come RataUnica a4b1b4d8) -->
	<elemento uuid="034ff84e-634f-43ac-8311-78bdae9a2865" attributi="padding-top=2.023pt"><xsl:choose><xsl:when test="normalize-space(unica/giorni)"><fo:block font-size="8pt" line-height="10.13pt"><xsl:value-of select="unica/tipo"/></fo:block><fo:block space-before="5.057pt"><xsl:call-template name="giorni"><xsl:with-param name="giorni" select="unica/giorni"/></xsl:call-template></fo:block></xsl:when><xsl:when test="normalize-space(unica/data)"><fo:block font-size="8pt" line-height="10.13pt">entro il</fo:block><fo:block space-before="5.057pt"><xsl:value-of select="unica/data"/></fo:block></xsl:when></xsl:choose></elemento>

	<!-- "Euro" + importo in RobotoMono grassetto, un solo spazio: riga con due font, padding ridotto di 0,48 pt -->
	<elemento uuid="11ce9986-b8f3-42ab-b6bb-5cc88fc7d966" attributi="white-space-collapse=false;padding-top=1.277pt"><fo:inline font-size="10pt">Euro</fo:inline><xsl:text> </xsl:text><fo:inline font-weight="bold" font-family="RobotoMono"><xsl:call-template name="importo"><xsl:with-param name="valore" select="unica/importo"/></xsl:call-template></fo:inline></elemento>

	<!-- $V{totaleRate} = count(//rata): oltre due rate rimanda al dettaglio, altrimenti il numero -->
	<elemento uuid="97fe84d1-91d1-42df-bb79-1dc3c6f2c44e"><xsl:choose><xsl:when test="count(//rata) &gt; 2">Importi e scadenze sono riportati nel dettaglio di ogni singola rata.</xsl:when><xsl:otherwise>Puoi pagare in <xsl:value-of select="count(//rata)"/> rate.</xsl:otherwise></xsl:choose></elemento>
	<elemento uuid="c60fd3a7-6dfb-4610-aec6-07fd9ba01b45">Puoi pagare per intero oppure in <xsl:value-of select="count(//rata)"/> rate.</elemento>

	<!-- informazioni dell'ente (sito, telefono, PEC): righe separate da <br/>, contate per l'interlinea fissa di Jasper -->
	<elemento uuid="d4ac1efe-f134-429b-af86-a8c431b61282" attributi="righe-xpath=1 + string-length(/AvvisoPagamentoInput/info_ente) - string-length(translate(/AvvisoPagamentoInput/info_ente, '&lt;', ''))"/>

</personalizzazioni>
