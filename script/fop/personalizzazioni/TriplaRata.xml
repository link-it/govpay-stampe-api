<?xml version="1.0" encoding="UTF-8"?>
<!--
	Parti di TriplaRata scritte a mano, applicate da jrxml2fo.py (vedi personalizzazioni/RataUnica.xml
	per il formato). Gli elementi corrispondono a quelli di RataUnica, con uuid diversi e la rata unica
	nell'elemento unica.
	Contesto dei percorsi relativi: l'elemento pagine/tripla.
-->
<personalizzazioni xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:fo="http://www.w3.org/1999/XSL/Format">

	<!-- "Rata unica " + (" entro il " + data | " " + tipo + " " + giorni): due spazi dopo "unica", come in Jasper -->
	<elemento uuid="c75a9751-9878-4116-9dfd-2b2487adfdfc" attributi="white-space-collapse=false">Rata unica <xsl:choose><xsl:when test="normalize-space(unica/giorni)"><xsl:value-of select="concat(' ', unica/tipo, ' ')"/><xsl:call-template name="giorni"><xsl:with-param name="giorni" select="unica/giorni"/></xsl:call-template></xsl:when><xsl:when test="normalize-space(unica/data)"> entro il <xsl:value-of select="unica/data"/></xsl:when></xsl:choose></elemento>

	<!-- "Importo" + importo formattato + " Euro " (come RataUnica b6232d33) -->
	<elemento uuid="8b3a92e3-6a99-4954-b5d6-efce3117cbbd" attributi="padding-top=2.023pt"><fo:block font-size="8pt" line-height="10.13pt">Importo</fo:block><fo:block space-before="5.057pt"><xsl:call-template name="importo"><xsl:with-param name="valore" select="unica/importo"/></xsl:call-template> Euro</fo:block></elemento>

	<!-- "oppure sul sito <del_tuo_ente>, " solo se valorizzato (come RataUnica d647fb00) -->
	<elemento uuid="5f78ab06-fd0b-45d7-a193-32ade7946f00" attributi="righe=2"><xsl:if test="normalize-space(/AvvisoPagamentoInput/del_tuo_ente)"><xsl:value-of select="concat('oppure sul sito ', /AvvisoPagamentoInput/del_tuo_ente, ', ')"/></xsl:if>dal tuo Home Banking, con la tua app di pagamento o con gli altri canali abilitati.</elemento>

	<!-- scadenza ("entro il" + data) oppure soglia (tipo + giorni) (come RataUnica a4b1b4d8) -->
	<elemento uuid="a7105871-a903-414b-94f8-17a77cb2c3e8" attributi="padding-top=2.023pt"><xsl:choose><xsl:when test="normalize-space(unica/giorni)"><fo:block font-size="8pt" line-height="10.13pt"><xsl:value-of select="unica/tipo"/></fo:block><fo:block space-before="5.057pt"><xsl:call-template name="giorni"><xsl:with-param name="giorni" select="unica/giorni"/></xsl:call-template></fo:block></xsl:when><xsl:when test="normalize-space(unica/data)"><fo:block font-size="8pt" line-height="10.13pt">entro il</fo:block><fo:block space-before="5.057pt"><xsl:value-of select="unica/data"/></fo:block></xsl:when></xsl:choose></elemento>

	<!-- "Euro" + importo in RobotoMono grassetto, un solo spazio: riga con due font, padding ridotto di 0,48 pt -->
	<elemento uuid="35755877-c0f0-4e06-88a3-7f69fb58c427" attributi="white-space-collapse=false;padding-top=1.277pt"><fo:inline font-size="10pt">Euro</fo:inline><xsl:text> </xsl:text><fo:inline font-weight="bold" font-family="RobotoMono"><xsl:call-template name="importo"><xsl:with-param name="valore" select="unica/importo"/></xsl:call-template></fo:inline></elemento>

	<!-- $V{totaleRate} = count(//rata): oltre tre rate rimanda al dettaglio, altrimenti il numero -->
	<elemento uuid="5666c0a2-2ecf-44d9-afcf-602cdfea85e4"><xsl:choose><xsl:when test="count(//rata) &gt; 3">Importi e scadenze sono riportati nel dettaglio di ogni singola rata.</xsl:when><xsl:otherwise>Puoi pagare in <xsl:value-of select="count(//rata)"/> rate.</xsl:otherwise></xsl:choose></elemento>
	<elemento uuid="1d58179c-f2b9-4d86-866e-ebae8935fcd9">Puoi pagare per intero oppure in <xsl:value-of select="count(//rata)"/> rate.</elemento>

	<!-- informazioni dell'ente (sito, telefono, PEC): righe separate da <br/>, contate per l'interlinea fissa di Jasper -->
	<elemento uuid="47d68bfe-0164-402b-804f-68aef649e58b" attributi="righe-xpath=1 + string-length(/AvvisoPagamentoInput/info_ente) - string-length(translate(/AvvisoPagamentoInput/info_ente, '&lt;', ''))"/>

</personalizzazioni>
