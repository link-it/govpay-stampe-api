					<font fontName="TitilliumWeb" size="8" isBold="false"/>
					<paragraph lineSpacing="Fixed" lineSpacingSize="6.5"/>
				</textElement>
				<textFieldExpression><![CDATA["<font face=\"TitilliumWeb-Bold\">Come si calcolano le scadenze?</font><br/>Il giorno della notifica non si conta. Se la scadenza è di domenica (o festivo), puoi pagare anche il primo giorno feriale successivo."]]></textFieldExpression>
			</textField>
			<staticText>
